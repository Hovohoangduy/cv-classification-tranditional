{
  "name": "E1_hog_svm",
  "features": "outputs/features/hog.npz",
  "feature_parameters": {"cell_size": 4, "block_size": 2, "num_bins": 9},
  "model": "linear_svm",
  "model_parameters": {
    "learning_rate": 0.01,
    "regularization": 0.0001,
    "epochs": 30,
    "batch_size": 256,
    "seed": 42,
    "verbose": true
  },
  "model_output": "outputs/models/hog_svm.pkl",
  "metrics_output": "outputs/metrics/hog_svm.json",
  "confusion_output": "outputs/figures/hog_svm_confusion.png",
  "loss_output": "outputs/figures/hog_svm_loss.png",
  "per_class_output": "outputs/figures/hog_svm_per_class.png",
  "predictions_output": "outputs/predictions/hog_svm.npz"
}
